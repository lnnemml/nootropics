POSTGRES_URL=postgresql://...         # from Vercel Neon integration
POSTGRES_URL_NON_POOLING=postgresql://...  # from Vercel Neon integration (unpooled, for migrations)
RESEND_API_KEY=re_...                 # from Resend dashboard
NEXT_PUBLIC_BASE_URL=http://localhost:3000  # production: https://noraalliance.com
NOWPAYMENTS_API_KEY=...
# Auth.js v5 — add one of these to .env.local (same value as Vercel NEXTAUTH_SECRET):
# AUTH_SECRET=your-secret-here          (primary name in Auth.js v5 beta.31+)
# NEXTAUTH_SECRET=your-secret-here      (fallback name, still accepted)
#
# Customer auth (Task 3.2) — no new secrets needed:
# - Uses the same AUTH_SECRET / NEXTAUTH_SECRET as admin auth
# - Cookie isolation prevents session conflicts:
#     admin:    next-auth.session-token  (at /api/auth)
#     customer: nora-customer-session    (at /api/auth/customer)
# - RESEND_API_KEY (above) is reused for magic-link emails
