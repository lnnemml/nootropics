POSTGRES_URL=postgresql://...         # from Vercel Neon integration
POSTGRES_URL_NON_POOLING=postgresql://...  # from Vercel Neon integration (unpooled, for migrations)
RESEND_API_KEY=re_...                 # from Resend dashboard
NEXT_PUBLIC_BASE_URL=http://localhost:3000  # production: https://noraalliance.com
NOWPAYMENTS_API_KEY=...
# Auth.js v5 (customer accounts only) — add one of these (same value as Vercel NEXTAUTH_SECRET):
# AUTH_SECRET=your-secret-here          (primary name in Auth.js v5 beta.31+)
# NEXTAUTH_SECRET=your-secret-here      (fallback name, still accepted)
#
# Admin panel (ADR 0024) — one password + a signed cookie; replaces ADMIN_PASSWORD_HASH.
ADMIN_PASSWORD=                       # the admin login password
ADMIN_AUTH_SECRET=                    # signs the admin session cookie (openssl rand -hex 32)
ADMIN_EMAIL=                          # ops alerts + campaign test sends (comma-separated)
#
# Analytics — Server-Side (CAPI)
META_CAPI_ACCESS_TOKEN=your_meta_capi_token_here
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret_here

# Analytics — Client-Side
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
NEXT_PUBLIC_META_PIXEL_ID=000000000000000

# Customer auth (Task 3.2):
# - Uses AUTH_SECRET / NEXTAUTH_SECRET, cookie nora-customer-session at /api/auth/customer
# - RESEND_API_KEY (above) is reused for magic-link emails

# Campaigns (ADR 0024) — NORA's own Resend segment. Required, no fallback: the Resend account
# is shared with isrib.shop.
RESEND_SEGMENT_ID=

# Affiliate program (ADR 0023)
AFFILIATES_ENABLED=                           # "true" = on; anything else = off
AFFILIATE_HASH_SECRET=                        # daily visitor-hash salt + the internal click route's shared secret (openssl rand -hex 32)
TELEGRAM_BOT_TOKEN=                           # Bot API token for commission notifications (email is the fallback)
